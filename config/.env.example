# Copy to config/.env and fill in. config/.env is gitignored.

# --- Django core ---
DEBUG=True
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# CORS_ALLOWED_ORIGINS and CSRF_TRUSTED_ORIGINS default to FRONTEND_ORIGINS.

# --- Production-only security switches (used when DEBUG=False) ---
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# USE_X_FORWARDED_PROTO=False

# --- PostgreSQL (docker compose --env-file config/.env up -d) ---
POSTGRES_DB=neurolearn
POSTGRES_USER=neurolearn
POSTGRES_PASSWORD=
DATABASE_URL=postgres://neurolearn:<POSTGRES_PASSWORD>@127.0.0.1:5433/neurolearn

# --- Redis / Celery (leave REDIS_URL empty to use the in-process LocMem cache) ---
REDIS_URL=redis://127.0.0.1:6380/1
CELERY_BROKER_URL=redis://127.0.0.1:6380/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6380/2

# --- Demo seeding (optional; a random password is generated and printed once if empty) ---
DEMO_PASSWORD=

# --- Thesis model overrides (optional, defaults in config/settings.py) ---
# THESIS_TAU=0.95
# THESIS_DELTA=0.10
# THESIS_LAMBDA=0.5
#
# Recommended settings for a running deployment (D72). They are NOT the
# defaults: the defaults are chapter II's values, and every result in the
# dissertation was produced with them.
#
#   THESIS_P_L_MAX=0.999
#     Ceiling of P(L)'. At the default 1.0, P(L) saturates after a run of
#     correct answers and wrong answers can no longer bring the topic back
#     to review. At 0.999, with P(T)=0.20, G=0.20, S=0.05, three consecutive
#     wrong answers take P(L) below tau - delta = 0.85 (two do not).
#
#   THESIS_LAMBDA=0.0
#     Turns off the prerequisite-based initial estimate. D71's post-hoc
#     analysis on Junyi found AUC decreasing monotonically in lambda, so it
#     stays off until it is shown to help on local data.
